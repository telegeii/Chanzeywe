# Copy this file to `.env` in this same folder and fill in real values.
# `.env` is git-ignored — never commit real credentials.

# ── Database (optional — defaults to XAMPP's root/no-password if unset) ──
# DB_HOST=localhost
# DB_NAME=chanzeywe_db
# DB_USER=root
# DB_PASS=

# ── Site URL (used to build links in acceptance emails) ──
# SITE_URL=https://www.chanzeywetvc.ac.ke

# ── Outbound email (acceptance offer letters) ──
# Using Gmail SMTP with chanzeywetvc@gmail.com (the address already
# published site-wide) is the simplest option:
#   1. Turn on 2-Step Verification on that Google account.
#   2. Google Account -> Security -> App Passwords -> generate one for "Mail".
#   3. Paste the 16-character password below (SMTP_PASSWORD).
# Until these are filled in with real values, acceptance emails fail
# silently (logged server-side) — the rest of the app is unaffected.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=chanzeywetvc@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM_EMAIL=chanzeywetvc@gmail.com
SMTP_FROM_NAME=Chanzeywe Vocational Training College
